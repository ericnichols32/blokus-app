# Copy to .env.local and fill in from the Firebase console, then restart `npm run dev`.
# See the Accounts section of the README for where these come from.
#
# With this file absent or blank the app still runs: usernames are saved on the
# device only, and nothing is shared. .env.local is gitignored.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
